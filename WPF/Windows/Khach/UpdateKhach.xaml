<Window x:Class="HoanMyClinic.Windows.Khach.UpdateKhach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="800" Height="410"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Loaded="UpdateKhach_Loaded">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <!-- ROWS -->
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountEdit" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="CẬP NHẬT KHÁCH" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- AVATAR -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Border Width="180" Height="180" CornerRadius="12" Margin="0,10"
                            BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB">
                        <Image x:Name="imgAvatar" Stretch="UniformToFill"/>
                    </Border>

                    <Button x:Name="btnChonAvt" Click="btnChonAvt_Click" Width="140" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Image"/>
                            <TextBlock Text="Chọn ảnh" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- FORM -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="txtName" Grid.Row="0" Margin="10,0" Height="40" Padding="12,6"
                             materialDesign:HintAssist.Hint="Họ và tên"/>

                    <ComboBox x:Name="cboGender" Grid.Row="0" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                              materialDesign:HintAssist.Hint="Giới tính"/>

                    <DatePicker x:Name="dtpBirth" Grid.Row="1" Margin="10,0" Height="40" Padding="12,6"
                                materialDesign:HintAssist.Hint="Ngày sinh"/>

                    <TextBox x:Name="txtPhone" Grid.Row="1" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                             materialDesign:HintAssist.Hint="Số điện thoại"/>

                    <TextBox x:Name="txtEmail" Grid.Row="2" Margin="10,0" Height="40" Padding="12,6"
                             materialDesign:HintAssist.Hint="Email liên hệ"/>

                    <TextBox x:Name="txtAddress" Grid.Row="2" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                             materialDesign:HintAssist.Hint="Địa chỉ"/>

                    <DatePicker x:Name="dtpDateCreate" Grid.Row="3" Margin="10,0" Height="40" Padding="12,6"
                                IsEnabled="False" materialDesign:HintAssist.Hint="Ngày tạo"/>

                    <DatePicker x:Name="dtpDateUpdate" Grid.Row="3" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                                IsEnabled="False" materialDesign:HintAssist.Hint="Ngày cập nhật"/>
                </Grid>
            </Grid>
            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>