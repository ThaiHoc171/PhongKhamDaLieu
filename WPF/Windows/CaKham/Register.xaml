<Window x:Class="HoanMyClinic.Windows.CaKham.Register"
        Loaded="Register_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="600" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    Padding="12,6"
                    MouseDown="Header_MouseDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PlusCircle"
                                             Width="50" Height="50"
                                             Margin="0,0,10,0"
                                             Foreground="White"/>

                    <TextBlock Text="ĐĂNG KÝ CA KHÁM"
                               FontSize="20"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtID" Grid.Row="0"
                         Margin="10" Height="40" Padding="12,6" IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Mã ca khám"/>

                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1"
                         Margin="10" Height="40" Padding="12,6" IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Khung giờ / Ngày"/>
                <TextBox x:Name="txtDoctor" Grid.Row="1" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6" IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Bác sĩ"/>
                
                <ComboBox x:Name="cboUser" Grid.Row="2" Grid.ColumnSpan="2"
                          Margin="10" Height="40" Padding="12,6"
                          IsEditable="True" IsTextSearchEnabled="False"
                          KeyUp="cboUser_KeyUp"
                          materialDesign:HintAssist.Hint="Bệnh nhân"/>

                <TextBox x:Name="txtReason" Grid.Row="3" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Lý do khám"/>

                <TextBox x:Name="txtNote" Grid.Row="4" Grid.ColumnSpan="2"
                         Margin="10" Padding="12,6" AcceptsReturn="True"
                         materialDesign:HintAssist.Hint="Ghi chú"/>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnClose" Click="btnClose_Click"
                            Width="100" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave" Click="btnSave_Click"
                            Width="100" Margin="5"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>