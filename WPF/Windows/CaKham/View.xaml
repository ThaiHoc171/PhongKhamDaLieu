<Window x:Class="HoanMyClinic.Windows.CaKham.View"
        Loaded="View_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="650" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Eye" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="CHI TIẾT CA KHÁM" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20" IsEnabled="False">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtID" Grid.Row="0" Margin="10" Height="40" Padding="12,6"
                         IsReadOnly="True" materialDesign:HintAssist.Hint="Mã ca khám"/>

                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="10" Height="40" Padding="12,6"
                         IsReadOnly="True" materialDesign:HintAssist.Hint="Khung giờ / Ngày"/>

                <TextBox x:Name="txtUser" Grid.Row="1" Margin="10" Height="40" Padding="12,6"
                         IsReadOnly="True" materialDesign:HintAssist.Hint="Họ và tên"/>

                <TextBox x:Name="txtStatus" Grid.Row="1" Grid.Column="1" Margin="10" Height="40" Padding="12,6"
                         IsReadOnly="True" materialDesign:HintAssist.Hint="Trạng thái"/>
                <TextBox x:Name="txtDoctor" Grid.Row="2" Grid.Column="0" 
                         Margin="10" Height="40" Padding="12,6"
                         IsReadOnly="True" materialDesign:HintAssist.Hint="Bác sĩ"/>
                <TextBox x:Name="txtLyDo" Grid.Row="2" Grid.Column="1" 
                         Margin="10" Height="40" Padding="12,6"
                         IsReadOnly="True" materialDesign:HintAssist.Hint="Lý do"/>

                <TextBox x:Name="txtGhiChu" Grid.Row="3" Grid.ColumnSpan="2" Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Ghi chú"/>

                <DatePicker x:Name="dtpRegistration" Grid.Row="4" Margin="10" Height="40" Padding="12,6"
                            materialDesign:HintAssist.Hint="Ngày đăng ký"/>

                <DatePicker x:Name="dtpAppointment" Grid.Row="4" Grid.Column="1" Margin="10" Height="40" Padding="12,6"
                            materialDesign:HintAssist.Hint="Ngày khám"/>

            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>