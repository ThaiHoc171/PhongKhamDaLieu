<Window x:Class="WPF.Windows.CaKham.ThemLich"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="Palatino Linotype" FontWeight="Bold" ResizeMode="NoResize"
        Width="425" Height="510" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Border BorderBrush="#D7E6F2" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#42A5F5" Padding="16" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PlusCircle" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Thêm lịch vào ca khám" FontSize="16" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DatePicker x:Name="dtpStart" Grid.Row="0" Grid.Column="0" Margin="8" Padding="12,6" Height="45"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                materialDesign:HintAssist.Hint="Ngày bắt đầu"
                                materialDesign:TextFieldAssist.TextFieldCornerRadius="20"/>

                    <DatePicker x:Name="dtpEnd" Grid.Row="0" Grid.Column="1" Margin="8" Padding="12,6" Height="45"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                materialDesign:HintAssist.Hint="Ngày kết thúc"
                                materialDesign:TextFieldAssist.TextFieldCornerRadius="20"/>

                    <Button x:Name="btnAdd" Click="btnAdd_Click" Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="8,10" Height="42" Width="140" HorizontalAlignment="Center"
                            Background="#028BDF" Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="20">
                        <TextBlock Text="Thêm ca khám" FontWeight="SemiBold"/>
                    </Button>

                    <TextBox x:Name="txtInComplete" Grid.Row="2" Grid.Column="0" Margin="8" Padding="12,6" Height="45" IsEnabled="False"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Ca chưa gán"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="20"/>

                    <TextBox x:Name="txtComplete" Grid.Row="2" Grid.Column="1" Margin="8" Padding="12,6" Height="45" IsEnabled="False"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Ca đã gán"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="20"/>

                    <TextBox x:Name="txtSum" Grid.Row="3" Grid.ColumnSpan="2" Margin="8" Padding="12,6" Height="45" IsEnabled="False"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Tổng ca thực hiện"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="20"/>

                    <TextBox x:Name="txtMessage" Grid.Row="4" Grid.ColumnSpan="2" Margin="8,15,8,0" Padding="12,6" Height="80" IsEnabled="False"
                             Background="#F5F5F5" Foreground="#444"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Thông báo"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="20"/>
                </Grid>
            </Border>
            <!-- Footer -->
            <Border Grid.Row="2" Background="#DEE5E9">
                <StackPanel Orientation ="Horizontal" VerticalAlignment="Center" HorizontalAlignment ="Right" Margin="0,0,10,0">
                    <Button x:Name="btnCancel" Click="btnCancel_Click" Width="70" Height="40" Margin="0,0,10,0"
                           BorderBrush="#E57373" Background="White"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           materialDesign:ButtonAssist.CornerRadius="20" >
                        <StackPanel Orientation ="Horizontal" HorizontalAlignment ="Center" VerticalAlignment="Center" Margin="2">
                            <TextBlock Text="Đóng" HorizontalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>