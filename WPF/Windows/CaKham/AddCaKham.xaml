<Window x:Class="HoanMyClinic.Windows.CaKham.AddCaKham"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="420" Height="300" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    Padding="12,6"
                    MouseDown="Header_MouseDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CalendarPlus" Width="50" Height="50"
                                             Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="TẠO CA KHÁM"
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <DatePicker x:Name="dtpBatDau" Grid.Row="0"
                            Margin="10" Height="40" Padding="12,6"
                            materialDesign:HintAssist.Hint="Ngày bắt đầu"/>

                <DatePicker x:Name="dtpKetThuc" Grid.Row="1"
                            Margin="10" Height="40" Padding="12,6"
                            materialDesign:HintAssist.Hint="Ngày kết thúc"/>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnClose" Click="btnClose_Click"
                            Width="100" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave" Click="btnSave_Click"
                            Width="100" Margin="5"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>