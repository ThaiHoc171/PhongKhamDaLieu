<Window x:Class="WPF.Windows.CaKham.AssignLich"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="500" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    Padding="12,6" MouseDown="Header_MouseDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CalendarPlus" Width="50" Height="50"
                                             Margin="0,0,10,0" Foreground="White"/>

                    <TextBlock Text="THÊM LỊCH CA KHÁM"
                               FontSize="20"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <DatePicker x:Name="dtpStart" Grid.Row="0"
                            Margin="10" Height="40" Padding="12,6"
                            materialDesign:HintAssist.Hint="Ngày bắt đầu"/>

                <DatePicker x:Name="dtpEnd" Grid.Row="0" Grid.Column="1"
                            Margin="10" Height="40" Padding="12,6"
                            materialDesign:HintAssist.Hint="Ngày kết thúc"/>

                <TextBox x:Name="txtInComplete" Grid.Row="1"
                         Margin="10" Height="40" Padding="12,6" IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Ca chưa gán"/>

                <TextBox x:Name="txtComplete" Grid.Row="1" Grid.Column="1"
                         Margin="10" Height="40" Padding="12,6" IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Ca đã gán"/>

                <TextBox x:Name="txtSum" Grid.Row="2" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6" IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Tổng ca thực hiện"/>

                <TextBox x:Name="txtMessage" Grid.Row="3" Grid.ColumnSpan="2"
                         Margin="10" Padding="12,6" AcceptsReturn="True" IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Thông báo"/>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnClose"
                            Click="btnClose_Click"
                            Width="100"
                            Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnAdd" Click="btnAdd_Click"
                            Width="150" Margin="5"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus"/>
                            <TextBlock Text="Thêm ca khám" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>