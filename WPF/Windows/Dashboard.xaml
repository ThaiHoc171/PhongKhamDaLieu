<Page x:Class="WPF.Windows.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6FB">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                CornerRadius="20"
                Padding="30">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6C63FF" Offset="0"/>
                    <GradientStop Color="#8F8BFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="👋 Good Morning, Doctor"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Welcome back to HoanMy Clinic System"
                           FontSize="14"
                           Margin="0,6,0,0"
                           Foreground="#ECECFF"/>
            </StackPanel>

        </Border>


        <!-- STATISTICS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,25,0,0">

            <!-- PATIENTS -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="🧑‍⚕️ Total Patients" Foreground="Gray"/>
                    <TextBlock Text="580" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- APPOINTMENTS -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="📅 Appointments Today" Foreground="Gray"/>
                    <TextBlock Text="38" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- DOCTORS -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="👨‍⚕️ Doctors" Foreground="Gray"/>
                    <TextBlock Text="12" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- ROOMS -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="🏥 Rooms" Foreground="Gray"/>
                    <TextBlock Text="8" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- PHONE CALLS -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="📞 Calls" Foreground="Gray"/>
                    <TextBlock Text="25" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- LAB TEST -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="🧪 Lab Tests" Foreground="Gray"/>
                    <TextBlock Text="64" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- DEVICES -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="⚙ Medical Devices" Foreground="Gray"/>
                    <TextBlock Text="42" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- UNREAD MAIL -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="📧 Unread Mail" Foreground="Gray"/>
                    <TextBlock Text="05" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </UniformGrid>


        <!-- LOWER SECTION -->
        <Grid Grid.Row="2" Margin="0,30,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- TODAY SCHEDULE -->
            <Border Background="White"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,0,15,0">

                <StackPanel>

                    <TextBlock Text="Today's Schedule"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <ListView Margin="0,10,0,0">

                        <ListViewItem>08:00 - Patient Nguyen Van A</ListViewItem>
                        <ListViewItem>09:00 - Patient Tran Thi B</ListViewItem>
                        <ListViewItem>10:30 - Patient Le Van C</ListViewItem>
                        <ListViewItem>13:30 - Patient Pham Thi D</ListViewItem>

                    </ListView>

                </StackPanel>

            </Border>


            <!-- RECENT ACTIVITY -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="16"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Recent Activity"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <ListView Margin="0,10,0,0">

                        <ListViewItem>✔ New patient registered</ListViewItem>
                        <ListViewItem>✔ Lab result completed</ListViewItem>
                        <ListViewItem>✔ Device assigned</ListViewItem>
                        <ListViewItem>✔ Appointment created</ListViewItem>

                    </ListView>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>
</Page>