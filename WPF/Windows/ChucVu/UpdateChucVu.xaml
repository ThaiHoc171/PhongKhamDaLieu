<Window x:Class="WPF.Windows.ChucVu.UpdateChucVu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Loaded="UpdateChucVu_Loaded"
        Width="450" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <!-- ROW -->
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PencilCircle" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="CẬP NHẬT CHỨC VỤ" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Tên -->
                <TextBox x:Name="txtName" Grid.Row="0" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Tên chức vụ"/>

                <!-- Mô tả -->
                <TextBox x:Name="txtDescription" Grid.Row="1" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Mô tả"/>

                <!-- Ngày tạo -->
                <DatePicker x:Name="dtpDateCreate" Grid.Row="2"
                            Margin="10" Height="40" Padding="12,6"
                            IsEnabled="False"
                            materialDesign:HintAssist.Hint="Ngày tạo"/>

                <!-- Ngày cập nhật -->
                <DatePicker x:Name="dtpDateUpdate" Grid.Row="2" Grid.Column="1"
                            Margin="10" Height="40" Padding="12,6"
                            IsEnabled="False"
                            materialDesign:HintAssist.Hint="Ngày cập nhật"/>

                <!-- Trạng thái -->
                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Hoạt động" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ToggleButton x:Name="btnActive"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}">
                        <ToggleButton.LayoutTransform>
                            <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                        </ToggleButton.LayoutTransform>
                    </ToggleButton>
                </StackPanel>

            </Grid>
            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" 
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>