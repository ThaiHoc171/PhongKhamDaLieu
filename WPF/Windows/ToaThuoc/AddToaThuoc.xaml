<Window x:Class="WPF.Windows.ToaThuoc.AddToaThuoc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="800" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Loaded="AddToaThuoc_Loaded">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#42A5F5" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PlusCircle" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="THÊM TOA THUỐC" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtId"
                         Grid.Row="0" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         IsEnabled="False"
                         materialDesign:HintAssist.Hint="Mã phiên khám"/>

                <TextBox x:Name="txtDoctor"
                         Grid.Row="1" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         IsEnabled="False"
                         materialDesign:HintAssist.Hint="Bác sĩ kê đơn"/>

                <TextBox x:Name="txtNotes"
                         Grid.Row="2" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Ghi chú"/>

                <ComboBox x:Name="cboMedicine"
                          Grid.Row="3" Grid.Column="0"
                          Margin="10"
                          materialDesign:HintAssist.Hint="Tên thuốc"/>

                <TextBox x:Name="numQuantity"
                         Grid.Row="3" Grid.Column="1"
                         Margin="10"
                         PreviewTextInput="NumberOnly"
                         materialDesign:HintAssist.Hint="Số lượng"/>

                <TextBox x:Name="txtDosage"
                         Grid.Row="4" Grid.ColumnSpan="2"
                         Margin="10"
                         materialDesign:HintAssist.Hint="Liều dùng"/>

                <Button x:Name="btnAdd"
                        Grid.Row="4" Grid.Column="1"
                        Width="120" Height="40"
                        HorizontalAlignment="Right"
                        Margin="10"
                        Click="btnAdd_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus"/>
                        <TextBlock Text="Thêm" Margin="5,0"/>
                    </StackPanel>
                </Button>

                <!-- DATA GRID -->
                <Border Grid.Row="5" Grid.ColumnSpan="2"
                        Margin="10"
                        Padding="5"
                        Background="White"
                        CornerRadius="10">

                    <Grid>

                        <DataGrid x:Name="GridContent"
                                  ItemsSource="{Binding Items}"
                                  SelectionChanged="GridContent_SelectionChanged"
                                  HeadersVisibility="Column"/>

                        <TextBlock Text="Không có dữ liệu"
                                   Foreground="#9CA3AF"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>
                </Border>

            </Grid>
            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5"
                            BorderBrush="#E57373" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" 
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>