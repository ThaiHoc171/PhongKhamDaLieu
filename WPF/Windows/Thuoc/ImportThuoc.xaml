<Window x:Class="WPF.Windows.Thuoc.ImportThuoc"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="750" Height="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <!-- ROW -->
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    Padding="12,6"
                    MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileExcel" Width="50" Height="50"
                                             Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="IMPORT THUỐC"
                               FontSize="20"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <!-- FILE -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtFile" Margin="10" Height="40"
                             Padding="12,6" IsReadOnly="True"
                             materialDesign:HintAssist.Hint="File Excel"/>

                    <Button x:Name="btnChooseFile" Grid.Column="1"
                            Margin="10,0" Width="120"
                            Click="btnChooseFile_Click"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Folder"/>
                            <TextBlock Text="Chọn file" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- SHEET + ACTION -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="cbSheet"
                              Margin="10,0"
                              Height="40"
                              materialDesign:HintAssist.Hint="Sheet"/>

                    <Button x:Name ="btnPreview"  Grid.Column="1"
                            Margin="5,0" Width="120"
                            Click="btnPreview_Click"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eye"/>
                            <TextBlock Text="Preview" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <!-- NEW: VALIDATE -->
                    <Button x:Name="btnValidate" Grid.Column="2"
                            Click="btnValidate_Click"
                            Margin="5,0" Width="120"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check"/>
                            <TextBlock Text="Validate" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- SUMMARY -->
                <TextBlock x:Name="txtSummary"
                           Grid.Row="2"
                           Margin="10,5"
                           Foreground="Gray"
                           FontStyle="Italic"/>

                <!-- PREVIEW -->
                <DataGrid x:Name="gridPreview"
                          Grid.Row="3"
                          Margin="10"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AlternatingRowBackground="#F7F7F7"
                          RowBackground="White"
                          ColumnWidth="*"/>

                <!-- ERROR CARD -->
                <Border Grid.Row="4"
                        Margin="10" Padding="8"
                        Background="#FFF5F5" BorderBrush="#F5C2C7"
                        BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Danh sách lỗi" Foreground="Red"
                                   Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <ListBox x:Name="lstErrors" Foreground="Red"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5"
                            BorderBrush="#E57373" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" 
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>