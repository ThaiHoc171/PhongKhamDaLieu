<Window x:Class="HoanMyClinic.Windows.ThietBi.UpdateThietBi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="650" Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Loaded="UpdateThietBi_Loaded">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#42A5F5" Padding="12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PencilCircle" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="CẬP NHẬT THIẾT BỊ" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtName"
                         Grid.Row="0" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Tên thiết bị"/>

                <TextBox x:Name="txtCategory"
                         Grid.Row="1" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Loại thiết bị"/>

                <DatePicker x:Name="dtpDateCreate"
                            Grid.Row="2" Grid.Column="0"
                            Margin="10" Height="40" Padding="12,6"
                            IsEnabled="False"
                            Language="vi-VN"
                            materialDesign:HintAssist.Hint="Ngày tạo"/>

                <DatePicker x:Name="dtpDateUpdate"
                            Grid.Row="2" Grid.Column="1"
                            Margin="10" Height="40" Padding="12,6"
                            IsEnabled="False"
                            Language="vi-VN"
                            materialDesign:HintAssist.Hint="Ngày cập nhật"/>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="10"
                            VerticalAlignment="Center">

                    <TextBlock Text="Hoạt động" Foreground="#6B7280" Margin="0,0,10,0"/>

                    <ToggleButton x:Name="btnActive">
                        <ToggleButton.LayoutTransform>
                            <ScaleTransform ScaleX="1.6" ScaleY="1.6"/>
                        </ToggleButton.LayoutTransform>
                    </ToggleButton>

                </StackPanel>

            </Grid>
            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5"
                            BorderBrush="#E57373" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" 
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>