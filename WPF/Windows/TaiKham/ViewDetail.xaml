<Window x:Class="HoanMyClinic.Windows.TaiKham.ViewDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="520" Height="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <!-- ROW -->
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PlusCircle" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="CHI TIẾT PHIẾU TÁI KHÁM" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtTaiKhamId" IsReadOnly="True"
                         Grid.Row="0" Grid.Column="0" Margin="10"
                         materialDesign:HintAssist.Hint="Mã tái khám"/>

                <TextBox x:Name="txtPhienKhamId" IsReadOnly="True"
                         Grid.Row="0" Grid.Column="1" Margin="10"
                         materialDesign:HintAssist.Hint="Phiên khám gốc"/>

                <TextBox x:Name="txtBenhNhan" IsReadOnly="True"
                         Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10"
                         materialDesign:HintAssist.Hint="Bệnh nhân"/>

                <DatePicker x:Name="dtpDate" IsEnabled="False"
                            Grid.Row="2" Grid.Column="0" Margin="10"
                            materialDesign:HintAssist.Hint="Ngày dự kiến"/>
                <DatePicker x:Name="dtpDateCreate" IsEnabled="False"
                            Grid.Row="2" Grid.Column="1" Margin="10"
                            materialDesign:HintAssist.Hint="Ngày tạo phiếu"/>

                <TextBox x:Name="txtTrangThai" IsReadOnly="True"
                         Grid.Row="3" Margin="10"
                         materialDesign:HintAssist.Hint="Trạng thái"/>

                <TextBox x:Name="txtReason"
                         Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                         Margin="10" Height="80" TextWrapping="Wrap"
                         AcceptsReturn="True" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         materialDesign:HintAssist.Hint="Lý do"/>
            </Grid>
            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5"
                            BorderBrush="#E57373" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>