<Window x:Class="WPF.Windows.KhamBenh.ViewCls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="620" Height="410"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Loaded="ViewCls_Loaded">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <!-- ROWS -->
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Eye" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="XEM CẬN LÂM SÀNG" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtRequestedBy" Grid.Row="0" Margin="10,0" Height="40" Padding="12,6"
                         IsReadOnly="False"
                         materialDesign:HintAssist.Hint="Bác sĩ chỉ định"/>

                <TextBox x:Name="txtPerformedBy" Grid.Row="0" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                         IsReadOnly="False"
                         materialDesign:HintAssist.Hint="Nhân viên thực hiện"/>

                <TextBox x:Name="txtCls" Grid.Row="1" Margin="10,0" Height="40" Padding="12,6"
                         IsReadOnly="False"
                         materialDesign:HintAssist.Hint="Cận lâm sàng"/>

                <TextBox x:Name="txtResult" Grid.Row="1" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                         IsReadOnly="False"
                         materialDesign:HintAssist.Hint="Kết quả"/>

                <TextBox x:Name="txtFilePath" Grid.Row="2" Margin="10,0" Height="40" Padding="12,6"
                         IsReadOnly="True"
                         materialDesign:HintAssist.Hint="File đính kèm"/>

                <TextBox x:Name="txtNotes" Grid.Row="2" Grid.Column="1" Margin="10,0" Padding="12,6"
                         IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Ghi chú"/>

                <DatePicker x:Name="dtpDate" Grid.Row="3" Margin="10,0" Height="40" Padding="12,6"
                            IsEnabled="False"
                            materialDesign:HintAssist.Hint="Ngày thực hiện"/>

                <TextBox x:Name="txtStatus" Grid.Row="3" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                         IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Trạng thái"/>

            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5"
                            BorderBrush="#E57373" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnViewFile" Click="btnViewFile_Click" Width="110" Margin="5"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eye"/>
                            <TextBlock Text="Xem file" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>