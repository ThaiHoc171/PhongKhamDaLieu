<Window x:Class="HoanMyClinic.Windows.HSBenhAn.AddHoSo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="550" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PlusCircle" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="THÊM HỒ SƠ BỆNH ÁN" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtName" Grid.Row="0" Grid.ColumnSpan="2"
                         Margin="10" Padding="12,6" IsEnabled="False"
                         materialDesign:HintAssist.Hint="Tên bệnh nhân"/>

                <TextBox x:Name="txtUnderlying" Grid.Row="1"
                         Margin="10" Padding="12,6"
                         materialDesign:HintAssist.Hint="Bệnh nền"/>

                <TextBox x:Name="txtAllergy" Grid.Row="1" Grid.Column="1"
                         Margin="10" Padding="12,6"
                         materialDesign:HintAssist.Hint="Dị ứng"/>

                <TextBox x:Name="txtMedHistory" Grid.Row="2"
                         Margin="10" Padding="12,6"
                         materialDesign:HintAssist.Hint="Tiền sử bệnh"/>

                <TextBox x:Name="txtFamHistory" Grid.Row="2" Grid.Column="1"
                         Margin="10" Padding="12,6"
                         materialDesign:HintAssist.Hint="Tiền sử gia đình"/>

                <TextBox x:Name="txtLifestyle" Grid.Row="3" Grid.ColumnSpan="2"
                         Margin="10" Padding="12,6"
                         materialDesign:HintAssist.Hint="Thói quen sống"/>

                <TextBox x:Name="txtNotes" Grid.Row="4" Grid.ColumnSpan="2"
                         Margin="10" Padding="12,6"
                         materialDesign:HintAssist.Hint="Thông tin khác"/>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>