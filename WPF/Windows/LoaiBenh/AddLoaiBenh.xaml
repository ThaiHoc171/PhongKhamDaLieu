<Window x:Class="HoanMyClinic.Windows.LoaiBenh.AddLoaiBenh"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="620" Height="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <!-- ROW -->
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PlusCircle" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="THÊM LOẠI BỆNH" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Row 1 -->
                <TextBox x:Name="txtName" Grid.Row="0" Margin="10,0" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Tên bệnh"/>

                <TextBox x:Name="txtScienceName" Grid.Row="0" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Tên khoa học"/>

                <!-- Row 2 -->
                <TextBox x:Name="txtGroup" Grid.Row="1" Margin="10,0" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Nhóm bệnh"/>

                <ComboBox x:Name="cboSeverity" Grid.Row="1" Grid.Column="1" Margin="10,0" Height="40" Padding="12,6"
                          materialDesign:HintAssist.Hint="Độ nghiêm trọng"/>

                <!-- Row 3 -->
                <ComboBox x:Name="cboPopularity" Grid.Row="2" Margin="10,0" Height="40" Padding="12,6"
                          materialDesign:HintAssist.Hint="Độ phổ biến"/>

                <TextBox x:Name="txtDescription" Grid.Row="2" Grid.Column="1" Margin="10,0" Padding="12,6"
                         AcceptsReturn="True"
                         materialDesign:HintAssist.Hint="Mô tả"/>

            </Grid>
            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5"
                            BorderBrush="#E57373" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" 
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>