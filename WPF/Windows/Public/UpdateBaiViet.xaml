<Window x:Class="HoanMyClinic.Windows.Public.UpdateBaiViet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="1080" Height="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="CẬP NHẬT BÀI VIẾT" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="350" Height="300" CornerRadius="12" Margin="0,10"
BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB">
                        <Image x:Name="imgAvatar" Stretch="UniformToFill"/>
                    </Border>

                    <Button x:Name="btnChoosePic" Click="btnChoosePic_Click" Width="140" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Image"/>
                            <TextBlock Text="Chọn ảnh" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Grid.Column="1" Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===== THÔNG TIN CHÍNH ===== -->
                    <Border Grid.Row="0" Margin="10" Padding="15"
                Background="White" CornerRadius="12"
                BorderBrush="#E5E7EB" BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="txtName" Margin="5" Grid.Row="0"
                             materialDesign:HintAssist.Hint="Tiêu đề"/>

                            <TextBox x:Name="txtTomtat" Margin="5" Grid.Row="0" Grid.Column="1"
                             materialDesign:HintAssist.Hint="Tóm tắt"/>

                            <ComboBox x:Name="cboDisease" Margin="5" Grid.Row="1" Grid.ColumnSpan="2"
                              materialDesign:HintAssist.Hint="Loại bệnh"/>
                            <TextBox x:Name="txtContent" Height="200" Margin="5"
                         Grid.Row="2" Grid.ColumnSpan="2"
                             materialDesign:HintAssist.Hint="Nội dung"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="10" Padding="15"
                Background="#F9FAFB" CornerRadius="12"
                BorderBrush="#E5E7EB" BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Trạng thái" FontWeight="SemiBold"/>
                                <Border Background="#E0F2FE" CornerRadius="8" Padding="6" Margin="0,5,5,0">
                                    <TextBlock x:Name="txtTrangThai" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Lượt xem" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtLuotXem" Margin="0,5,5,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ngày đăng" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtNgayDang" Margin="0,5,5,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Cập nhật" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtNgayCapNhat" Margin="0,5,5,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">

                        <Button x:Name="btnPost" Width="120" Margin="5" Click="btnPost_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Upload"/>
                                <TextBlock Text="Đăng bài" Margin="5,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnHide" Width="100" Margin="5" Click="btnHide_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="EyeOff"/>
                                <TextBlock Text="Ẩn" Margin="5,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnSaveDraft" Width="110" Margin="5" Click="btnSaveDraft_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveEdit"/>
                                <TextBlock Text="Lưu nháp" Margin="5,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnDelete" Width="100" Margin="5" Click="btnDelete_Click"
                    Background="#FEE2E2" Foreground="Red" BorderBrush="Red">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete"/>
                                <TextBlock Text="Xóa" Margin="5,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">

                        <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close"/>
                                <TextBlock Text="Đóng" Margin="5,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5"
                    Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave"/>
                                <TextBlock Text="Lưu" Margin="5,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>