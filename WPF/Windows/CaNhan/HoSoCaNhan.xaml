<Window x:Class="WPF.Windows.CaNhan.HoSoCaNhan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="700" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Loaded="UpdateNhanVien_Loaded">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <!-- ROW -->
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountEdit" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="CẬP NHẬT HỒ SƠ CÁ NHÂN" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- AVATAR -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Border Width="200" Height="250" CornerRadius="12" Margin="0,10"
                            BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB">
                        <Image x:Name="imgAvatar" Stretch="UniformToFill"/>
                    </Border>

                    <Button x:Name="btnChooseAvt" Click="btnChooseAvt_Click" Width="140"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Image"/>
                            <TextBlock Text="Chọn ảnh" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- FORM -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <!-- ===== THÔNG TIN CÁ NHÂN ===== -->
                    <GroupBox Header="Thông tin cá nhân">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="txtHoTen" Grid.Row="0" Margin="10" 
                                     materialDesign:HintAssist.Hint="Họ và tên"/>
                            <ComboBox x:Name="cboGioiTinh" Grid.Row="1" Margin="10"
                                      materialDesign:HintAssist.Hint="Giới tính"/>
                            <DatePicker x:Name="dtpNgaySinh" Grid.Row="2" Margin="10"
                                        materialDesign:HintAssist.Hint="Ngày sinh"/>
                            <TextBox x:Name="txtSDT" Grid.Row="3" Margin="10"
                                     materialDesign:HintAssist.Hint="Số điện thoại"/>
                            <TextBox x:Name="txtEmail" Grid.Row="4" Margin="10"
                                     materialDesign:HintAssist.Hint="Email liên hệ"/>
                            <TextBox x:Name="txtDiaChi" Grid.Row="5" Margin="10"
                                     materialDesign:HintAssist.Hint="Địa chỉ"/>

                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5"
                            BorderBrush="#E57373" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" 
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>