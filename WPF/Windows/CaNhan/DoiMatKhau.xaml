<Window x:Class="HoanMyClinic.Windows.CaNhan.DoiMatKhau"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        ResizeMode="NoResize" Width="400" Height="340" 
        WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="12,6"
                MouseDown="Header_MouseDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="50" Height="50"
                                             Margin="0,0,10,0" Foreground="White"/>

                    <TextBlock Text="ĐỔI MẬT KHẨU"
                               FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtEmail" Grid.Row="0" IsReadOnly="True"
             materialDesign:HintAssist.Hint="Email"/>

                <!-- Mật khẩu cũ -->
                <Grid Grid.Row="1">
                    <PasswordBox x:Name="txtPassword" Padding="12,6"
                     materialDesign:HintAssist.Hint="Mật khẩu"/>
                    <TextBox x:Name="txtPasswordVisible" Padding="12,6" Visibility="Collapsed"
                 materialDesign:HintAssist.Hint="Mật khẩu"/>
                    <Button x:Name="btnTogglePassword" Width="30" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Style="{StaticResource MaterialDesignIconButton}"
                Click="btnTogglePassword_Click" Margin="0,0,4,0">
                        <materialDesign:PackIcon x:Name="iconTogglePassword" Kind="Eye"/>
                    </Button>
                </Grid>

                <!-- Mật khẩu mới -->
                <Grid Grid.Row="2">
                    <PasswordBox x:Name="txtNewPassword" Padding="12,6"
                     materialDesign:HintAssist.Hint="Mật khẩu mới"/>
                    <TextBox x:Name="txtNewPasswordVisible" Padding="12,6" Visibility="Collapsed"
                 materialDesign:HintAssist.Hint="Mật khẩu mới"/>
                    <Button x:Name="btnToggleNewPassword" Width="30" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Style="{StaticResource MaterialDesignIconButton}"
                Click="btnToggleNewPassword_Click" Margin="0,0,4,0">
                        <materialDesign:PackIcon x:Name="iconToggleNewPassword" Kind="Eye"/>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" 
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>

