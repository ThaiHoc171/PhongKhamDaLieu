<Window x:Class="HoanMyClinic.Windows.ChiTietPhong.UpdateDetailThietBi"
        Loaded="UpdateDetail_Load"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="500" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border BorderBrush="#8F8FAF" BorderThickness="1">
        <Grid Background="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12,6" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Pencil" Width="50" Height="50" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="CẬP NHẬT THIẾT BỊ" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <TextBox x:Name="txtPhong" Grid.Row="0"
                         Margin="10" Height="40" Padding="12,6"
                         IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Phòng"/>

                <TextBox x:Name="txtThietBi" Grid.Row="0" Grid.Column="1"
                         Margin="10" Height="40" Padding="12,6"
                         IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Thiết bị"/>

                <!-- Row 1 -->
                <TextBox x:Name="txtName" Grid.Row="1"
                         Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Mã tài sản"/>

                <DatePicker x:Name="dtpDateCreate" Grid.Row="1" Grid.Column="1"
                            Margin="10" Height="40" Padding="12,6"
                            IsEnabled="False"
                            materialDesign:HintAssist.Hint="Ngày nhập"/>

                <!-- Row 2 -->
                <TextBox x:Name="txtNote" Grid.Row="2" Grid.ColumnSpan="2"
                         Margin="10" Height="40" Padding="12,6"
                         materialDesign:HintAssist.Hint="Ghi chú"/>

                <!-- Row 3 -->
                <ComboBox x:Name="cboTinhTrang" Grid.Row="3"
                          Margin="10" Height="40"
                          materialDesign:HintAssist.Hint="Tình trạng"/>

            </Grid>

            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Background="#E5E9F8" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnClose" Click="btnClose_Click" Width="100" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"/>
                            <TextBlock Text="Đóng" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave" Click="btnSave_Click" Width="100" Margin="5" 
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text="Lưu" Margin="5,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>