<Application x:Class="HoanMyClinic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:HoanMyClinic.Common"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ================= MATERIAL ================= -->
            <ResourceDictionary.MergedDictionaries>

                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="DeepPurple"
                    SecondaryColor="Lime"/>

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!-- ================= CONVERTER ================= -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- ================= COLOR ================= -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="SuccessBrush"    Color="#10B981"/>
            <SolidColorBrush x:Key="WarningBrush"    Color="#F59E0B"/>
            <SolidColorBrush x:Key="DangerBrush"     Color="#EF4444"/>
            <SolidColorBrush x:Key="InfoBrush"       Color="#0EA5E9"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="CardBrush" Color="White"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#01050F"/>
            <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>

            <!-- ================= RADIUS (optional reuse) ================= -->
            <CornerRadius x:Key="RadiusSmall">10</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">15</CornerRadius>

            <!-- ================= TYPOGRAPHY ================= -->
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="Noto Sans"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Noto Sans"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            
            

            <!-- ================= BUTTON ================= -->
            <Style TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                        Value="{StaticResource RadiusLarge}"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                        Value="{StaticResource RadiusLarge}"/>
            </Style>

            <!-- ================= TEXTBOX ================= -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="{StaticResource RadiusLarge}"/>
            </Style>
            <!-- ================= PASSWORDBOX ================= -->
            <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="{StaticResource RadiusLarge}"/>
            </Style>

            <!-- ================= COMBOBOX ================= -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="{StaticResource RadiusLarge}"/>
                <Setter Property="Padding" Value="10,4"/>
            </Style>

            <!-- ================= DATEPICKER ================= -->
            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="{StaticResource RadiusLarge}"/>
            </Style>
            <!-- ================= DATAGRID ================= -->
            <Style TargetType="DataGrid">
                <Setter Property="RowHeight" Value="36"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>
            <!-- ================= GROUPBOX ================= -->
            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="BorderBrush" Value="#D4D4FA"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            </Style>
            <!-- ================= COMPONENT STYLE ================= -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PopupStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
                <Setter Property="BorderBrush" Value="Gray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>