<Page x:Class="WPF.Pages.TaiKhamPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCH -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="txtSearch" Width="250" Margin="5" Padding="12,6"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Tìm kiếm ..."/>
                    </StackPanel>

                    <!-- ACTION -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <ComboBox x:Name="cboStatus" Width="150" 
                                  Margin="5" Padding="12,6"
                                  materialDesign:HintAssist.Hint="Trạng thái"
                                  ItemsSource="{Binding StatusList}"
                                  SelectedItem="{Binding SelectedStatus}"/>
                        <Button Margin="5" Padding="12,6"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh"/>
                                <TextBlock Text="Refresh" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="10">

                <Grid>

                    <!-- DATA -->
                    <DataGrid x:Name="GridContent"
                              ItemsSource="{Binding Items}"
                              HeadersVisibility="Column"/>

                    <!-- EMPTY -->
                    <TextBlock Text="Không có dữ liệu"
                               Foreground="{StaticResource TextMuted}"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>
            </Border>

            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- PAGE SIZE -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBox Width="100" Margin="10" Padding="12,6"
                                 Text="{Binding PageSizeInput, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Số dòng"/>

                    </StackPanel>

                    <!-- PAGING -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Margin="10,0" Padding="12,6"
                                Command="{Binding FirstCommand}">
                            <materialDesign:PackIcon Kind="PageFirst"/>
                        </Button>

                        <Button Margin="10,0" Padding="12,6"
                                Command="{Binding PrevCommand}"
                                IsEnabled="{Binding CanGoPrev}">
                            <materialDesign:PackIcon Kind="ChevronLeft"/>
                        </Button>

                        <TextBlock Text="{Binding PageDisplay}" Margin="10,0" Padding="12,6"
                                   Width="80" VerticalAlignment="Center"/>

                        <Button Margin="10,0" Padding="12,6"
                                Command="{Binding NextCommand}"
                                IsEnabled="{Binding CanGoNext}">
                            <materialDesign:PackIcon Kind="ChevronRight"/>
                        </Button>

                        <Button Margin="10,0" Padding="12,6"
                                Command="{Binding LastCommand}">
                            <materialDesign:PackIcon Kind="PageLast"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- ================= LOADING ================= -->
        <Grid Background="#66000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <materialDesign:PackIcon Kind="Loading" Width="150" Height="150" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">

                <materialDesign:PackIcon.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate"/>
                </materialDesign:PackIcon.RenderTransform>

            </materialDesign:PackIcon>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                 Storyboard.TargetProperty="Angle"
                                 From="0" To="360"
                                 Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Grid>
</Page>