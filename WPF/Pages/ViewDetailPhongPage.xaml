<Page x:Class="WPF.Pages.ViewDetailPhongPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Margin="5" Padding="12,6"
                            Command="{Binding BackCommand}">
                            <materialDesign:PackIcon Kind="ArrowLeft"/>
                        </Button>

                        <TextBox Width="250" Margin="5" Padding="12,6"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Tìm thiết bị trong phòng"/>
                    </StackPanel>

                    <!-- ACTION -->
                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                        <Button Margin="5" Padding="12,6"
                            Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh"/>
                                <TextBlock Text="Refresh" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="5" Padding="12,6"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus"/>
                                <TextBlock Text="Thêm" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Border Grid.Row="1" Margin="0,10"
                    Style="{StaticResource CardStyle}" Padding="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: LIST -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Danh sách thiết bị"
                               FontWeight="Bold"
                               Margin="5"/>

                        <Grid Grid.Row="1">

                            <DataGrid x:Name="GridContent"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem}"
                                  HeadersVisibility="Column"/>

                            <TextBlock Text="Không có thiết bị"
                                   Foreground="{StaticResource TextMuted}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- DIVIDER -->
                    <Border Grid.Column="1" Background="#E5E7EB"/>

                    <!-- RIGHT: DETAIL -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Chi tiết thiết bị"
                               FontWeight="Bold"
                               Margin="5"/>

                        <Grid Grid.Row="1">

                            <DataGrid  x:Name="GridDetail" ItemsSource="{Binding ChiTietItems}"
                                  HeadersVisibility="Column"/>

                            <TextBlock Text="Chọn thiết bị để xem chi tiết"
                                   Foreground="{StaticResource TextMuted}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChiTietItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- PAGE SIZE -->
                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                        <TextBox Width="100" Height="35" Margin="0,-10"
                             Padding="12,6"
                             Text="{Binding PageSizeInput, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Số dòng"/>
                    </StackPanel>

                    <!-- PAGINATION -->
                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                        <Button Margin="5,0" Padding="12,6"
                            Command="{Binding FirstCommand}">
                            <materialDesign:PackIcon Kind="PageFirst"/>
                        </Button>

                        <Button Margin="5,0" Padding="12,6"
                            Command="{Binding PrevCommand}"
                            IsEnabled="{Binding CanGoPrev}">
                            <materialDesign:PackIcon Kind="ChevronLeft"/>
                        </Button>

                        <TextBlock Text="{Binding PageDisplay}"
                               Margin="10,0"
                               Padding="12,6"
                               Width="50"
                               VerticalAlignment="Center"/>

                        <Button Margin="5,0" Padding="12,6"
                            Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}">
                            <materialDesign:PackIcon Kind="ChevronRight"/>
                        </Button>

                        <Button Margin="5,0" Padding="12,6"
                            Command="{Binding LastCommand}">
                            <materialDesign:PackIcon Kind="PageLast"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ================= LOADING ================= -->
        <Grid Background="#66000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">

            <materialDesign:PackIcon Kind="Loading"
                                     Width="150"
                                     Height="150"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">

                <materialDesign:PackIcon.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate"/>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360"
                                             Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

    </Grid>
</Page>