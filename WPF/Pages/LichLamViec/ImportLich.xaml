<Page x:Class="HoanMyClinic.Pages.LichLamViec.ImportLich"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:conv="clr-namespace:HoanMyClinic.Common"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILE + SHEET -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBox Width="350" Margin="5" Padding="12,6"
                                 Text="{Binding FilePath}"
                                 IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="Chọn file Excel"/>

                        <Button Margin="5" Padding="12,6"
                                Command="{Binding ChooseFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Folder"/>
                                <TextBlock Text="Chọn file" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <ComboBox Width="200" Margin="5"
                                  ItemsSource="{Binding Sheets}"
                                  SelectedItem="{Binding SelectedSheet}"
                                  materialDesign:HintAssist.Hint="Sheet"/>

                        <Button Margin="5" Padding="12,6"
                                Command="{Binding PreviewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Eye"/>
                                <TextBlock Text="Preview" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- ACTION RIGHT -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Margin="5" Padding="12,6"
                                Command="{Binding ValidateCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Check"/>
                                <TextBlock Text="Kiểm tra" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="5" Padding="12,6"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave"/>
                                <TextBlock Text="Lưu" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- PREVIEW -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding Summary}"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,0,0,5"/>

                        <DataGrid x:Name="PreviewDataGrid"
                                  ItemsSource="{Binding PreviewData}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  Grid.Row="1"/>
                    </Grid>

                    <!-- ERRORS -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Lỗi"
                                   Foreground="{StaticResource TextMuted}"/>

                        <ListBox ItemsSource="{Binding Errors}"
                                 Foreground="Red"
                                 Grid.Row="1"/>
                    </Grid>

                </Grid>
            </Border>

            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Margin="0,10,0,0">

                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding Status}"
                                   VerticalAlignment="Center"
                                   Margin="10"/>

                    </StackPanel>
                </Grid>

            </Border>

        </Grid>

        <!-- ================= LOADING ================= -->
        <Grid Background="#66000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">

            <materialDesign:PackIcon Kind="Loading"
                                     Width="150"
                                     Height="150"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">

                <materialDesign:PackIcon.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate"/>
                </materialDesign:PackIcon.RenderTransform>

            </materialDesign:PackIcon>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360"
                                             Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

        </Grid>

    </Grid>
</Page>