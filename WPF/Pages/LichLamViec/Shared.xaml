<Page x:Class="WPF.Pages.LichLamViec.Shared"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- WEEK SELECT -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="220" Margin="5" Padding="12,6"
                                  materialDesign:HintAssist.Hint="Chọn tuần"
                                  ItemsSource="{Binding Weeks}" DisplayMemberPath="Display"
                                  SelectedValuePath="Page" SelectedValue="{Binding Page}"/>
                    </StackPanel>

                    <!-- ACTION -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="5" Padding="12,6" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh"/>
                                <TextBlock Text="Refresh" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                    Margin="0,10" Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER NGÀY -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Headers}" Margin="0,0,0,5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E0E7FF" CornerRadius="5" Margin="1" Padding="4">
                                    <TextBlock Text="{Binding}" FontWeight="Bold" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- CA SÁNG -->
                    <TextBlock Text="Ca sáng" FontWeight="Bold" Grid.Row="1" Margin="0,5,0,5"/>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Morning}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Color}" CornerRadius="5"
                                        Margin="1" Padding="6" MinHeight="100">

                                    <ItemsControl ItemsSource="{Binding NhanViens}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2" Padding="5" CornerRadius="6"
                                                        Background="#E0E7FF" BorderBrush="#00000020"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Text="{Binding NhanVien.Name}"/>

                                                        <TextBlock FontSize="11"
                                                                   Foreground="#444">
                                                            <Run Text="{Binding ChucVu}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding TenPhong}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- CA CHIỀU -->
                    <TextBlock Text="Ca chiều" FontWeight="Bold" Grid.Row="3" Margin="0,10,0,5"/>
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Afternoon}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Color}" CornerRadius="5"
                                        Margin="1" Padding="6" MinHeight="100">

                                    <ItemsControl ItemsSource="{Binding NhanViens}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2" Padding="5" CornerRadius="6"
                                                        Background="#E0E7FF" BorderBrush="#00000020"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Text="{Binding NhanVien.Name}"/>

                                                        <TextBlock FontSize="11"
                                                                   Foreground="#444">
                                                            <Run Text="{Binding ChucVu}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding TenPhong}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
            </Border>

            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Margin="5,0" Padding="12,6"
                            Command="{Binding FirstCommand}"
                            IsEnabled="{Binding CanGoPrev}">
                        <materialDesign:PackIcon Kind="PageFirst"/>
                    </Button>

                    <Button Margin="5,0" Padding="12,6"
                            Command="{Binding PrevCommand}"
                            IsEnabled="{Binding CanGoPrev}">
                        <materialDesign:PackIcon Kind="ChevronLeft"/>
                    </Button>

                    <Button Margin="5,0" Padding="12,6"
                            Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}">
                        <materialDesign:PackIcon Kind="ChevronRight"/>
                    </Button>

                    <Button Margin="5,0" Padding="12,6"
                            Command="{Binding LastCommand}"
                            IsEnabled="{Binding CanGoNext}">
                        <materialDesign:PackIcon Kind="PageLast"/>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= LOADING ================= -->
        <Grid Background="#66000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <materialDesign:PackIcon Kind="Loading" Width="150" Height="150" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">

                <materialDesign:PackIcon.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate"/>
                </materialDesign:PackIcon.RenderTransform>

            </materialDesign:PackIcon>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360"
                                     Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Grid>
</Page>