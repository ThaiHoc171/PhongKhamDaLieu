<Page x:Class="HoanMyClinic.Pages.LichLamViec.Personal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0" Margin="0,0,0,10"
                    Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- WEEK SELECT -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="220" Margin="5" Padding="12,6"
                                  materialDesign:HintAssist.Hint="Chọn tuần"
                                  ItemsSource="{Binding Weeks}" DisplayMemberPath="Display"
                                  SelectedValuePath="Page" SelectedValue="{Binding Page}"/>
                                        </StackPanel>

                    <!-- ACTION -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Margin="5" Padding="12,6"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh"/>
                                <TextBlock Text="Refresh" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Border Grid.Row="1" Margin="0,10" Padding="10"
                    Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER DAYS -->
                    <ItemsControl Grid.Row="0" Margin="0,0,0,5"
                                  ItemsSource="{Binding Headers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E0E7FF" CornerRadius="5"
                                        Margin="1" Padding="6">
                                    <TextBlock Text="{Binding}" FontWeight="Bold"
                                               TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- MORNING -->
                    <TextBlock Grid.Row="1" Margin="0,5,0,5"
                               Text="Ca sáng" FontWeight="Bold"/>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Morning}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Color}"
                                        CornerRadius="5" Margin="1"
                                        Padding="6" MinHeight="100">
                                    <TextBlock Text="{Binding ShiftDisplay}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- AFTERNOON -->
                    <TextBlock Grid.Row="3" Margin="0,10,0,5"
                               Text="Ca chiều" FontWeight="Bold"/>

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Afternoon}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Color}" CornerRadius="5"
                                        Margin="1" Padding="6" MinHeight="100">
                                    <TextBlock Text="{Binding ShiftDisplay}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- EMPTY -->
                    <TextBlock Text="Không có dữ liệu"
                               Foreground="{StaticResource TextMuted}" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Morning.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </Grid>
            </Border>

            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">

                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                    <Button Margin="5,0" Padding="12,6"
                Command="{Binding FirstCommand}"
                IsEnabled="{Binding CanGoPrev}">
                        <materialDesign:PackIcon Kind="PageFirst"/>
                    </Button>

                    <Button Margin="5,0" Padding="12,6"
                Command="{Binding PrevCommand}"
                IsEnabled="{Binding CanGoPrev}">
                        <materialDesign:PackIcon Kind="ChevronLeft"/>
                    </Button>

                    <Button Margin="5,0" Padding="12,6"
                Command="{Binding NextCommand}"
                IsEnabled="{Binding CanGoNext}">
                        <materialDesign:PackIcon Kind="ChevronRight"/>
                    </Button>

                    <Button Margin="5,0" Padding="12,6"
                Command="{Binding LastCommand}"
                IsEnabled="{Binding CanGoNext}">
                        <materialDesign:PackIcon Kind="PageLast"/>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= LOADING ================= -->
        <Grid Background="#66000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">

            <materialDesign:PackIcon Kind="Loading" Width="150" Height="150"
                                     Foreground="White"  HorizontalAlignment="Center"
                                     VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">

                <materialDesign:PackIcon.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate"/>
                </materialDesign:PackIcon.RenderTransform>

            </materialDesign:PackIcon>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

        </Grid>
    </Grid>
</Page>